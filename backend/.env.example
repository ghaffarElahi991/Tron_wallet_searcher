TRONFORGE_ENVIRONMENT=development
TRONFORGE_DATABASE_URL=postgresql+psycopg://tronforge:tronforge@localhost:5432/tronforge
TRONFORGE_JWT_SECRET=replace-with-at-least-32-random-characters
TRONFORGE_WORKER_API_KEY=replace-with-a-separate-long-random-worker-key
TRONFORGE_RESULT_ENCRYPTION_KEY=replace-with-a-separate-long-random-encryption-key
TRONFORGE_ADMIN_USERNAME=admin
TRONFORGE_ADMIN_PASSWORD=replace-with-one-long-operator-password
TRONFORGE_CORS_ORIGINS=http://localhost:3000
TRONFORGE_ACCESS_TOKEN_MINUTES=30
TRONFORGE_BROWSER_SESSION_DAYS=30
TRONFORGE_GENERATOR_MODE=simulator
